<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Joiefull" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Joiefull.Splash" parent="Theme.SplashScreen">
