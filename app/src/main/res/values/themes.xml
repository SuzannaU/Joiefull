        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_joiefull_foreground</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.Joiefull</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
